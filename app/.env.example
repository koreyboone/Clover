# Copy to .env.local for local development; set the same names in Vercel project settings.
# Never commit real values.

# Public: safe to expose to browsers. Access is limited by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: bypasses row-level security. Never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
